{
  "name": "lumo-desktop",
  "version": "1.0.1",
  "description": "Lumo",
  "main": "main.js",
  "author": "Lumo",
  "license": "UNLICENSED",
  "scripts": {
    "dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "ru.lumo.desktop",
    "productName": "Lumo",
    "files": [
      "main.js",
      "package.json",
      "icon.png",
      "app/**"
    ],
    "icon": "icon.png",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "Lumo-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Lumo-Portable-${version}.exe"
    }
  }
}